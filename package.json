{
  "name": "daimaxuexi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "node server/scripts/init.js",
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "make-code": "node server/scripts/make-code.js",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "start:all": "concurrently -k -n server,client -c blue,green \"npm.cmd run dev --workspace=server\" \"npm.cmd run dev --workspace=client\"",
    "verify:public-version": "node work-verify-public-version.js",
    "verify:public-full": "node work-verify-public-full.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
