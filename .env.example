# Local default port. Render injects PORT automatically in production.
PORT=3002

# Required security secrets. Use long random strings in production.
JWT_SECRET=replace-with-a-random-string
ENCRYPTION_KEY=replace-with-a-random-string

# Persistence paths. Local defaults are under server/data.
# Render production values should point to the mounted disk at /data.
APP_DATA_FILE=/data/app.json
LEARNING_DB_PATH=/data/learning.db

# CORS allowlist. Separate multiple origins with commas.
CORS_ORIGINS=https://liil42.github.io,http://localhost:5173,http://127.0.0.1:5173
